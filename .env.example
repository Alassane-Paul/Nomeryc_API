# Variables d'environnement pour Nomeryc Backend

# ==================== BASE DE DONNEES ====================
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nomeryc_db
DB_USER=root
DB_PASSWORD=your_password

# Pour SQLite (optionnel)
# DB_DIALECT=sqlite
# DB_STORAGE=database.sqlite

# ==================== JWT ====================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d

# ==================== SMTP (Email) ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@nomeryc.com

# ==================== FRONTEND ====================
FRONTEND_URL=http://localhost:3000

# ==================== CORS ====================
CORS_ORIGIN=http://localhost:3000

# ==================== NODE ====================
NODE_ENV=development
PORT=5000

# ========== UPLOADS ==========
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
# URL publique du serveur, utilisée pour construire les liens de fichiers
APP_URL=http://localhost:5000

# ========== STRIPE (paiement carte) ==========
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ========== FEDAPAY (paiement Mobile Money) ==========
FEDAPAY_SECRET_KEY=sk_sandbox_...
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_WEBHOOK_SECRET=wh_sandbox_...

# ========== REDIS (scalabilité Socket.IO multi-instance — optionnel) ==========
# Laisser vide pour une seule instance (mémoire locale, suffisant en dev / petit trafic)
REDIS_URL=redis://localhost:6379

# ========== STOCKAGE FICHIERS ==========
# 'local' (disque, par défaut) ou 's3' (AWS S3 / Cloudflare R2 / tout endpoint compatible S3)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Laisser vide pour AWS S3 ; renseigner pour Cloudflare R2 / MinIO (ex: https://<account>.r2.cloudflarestorage.com)
S3_ENDPOINT=
# URL publique de base si différente de l'endpoint (ex. domaine CDN R2 personnalisé)
S3_PUBLIC_URL=
